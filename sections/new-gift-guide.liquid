{%- comment -%}
  Gift Guide Hero Section with 3D Parallax Effect
{%- endcomment -%}

{{ 'section-gift-guide.css' | asset_url | stylesheet_tag }}

<div class="gift-guide">
  <div class="gift-guide__wrapper">
    <div class="gift-guide__header">
      <div class="gift-guide__logo">
        <h2 class="gift-guide__logo-text">{{ section.settings.logo_text }}</h2>
      </div>
      <div class="gift-guide__header-text">{{ section.settings.header_text }}</div>
      <a href="{{ section.settings.header_button_link }}" class="gift-guide__header-button">
        {{ section.settings.header_button_text }}
      </a>
    </div>

    <div class="gift-guide__content-container">
      <div class="gift-guide__text-content">
        <h1 class="gift-guide__title">{{ section.settings.title }}</h1>
        <p class="gift-guide__description">{{ section.settings.description }}</p>
        <a href="{{ section.settings.main_button_link }}" class="gift-guide__main-button">
          {{ section.settings.main_button_text }}
          <span class="gift-guide__main-button-arrow">→</span>
        </a>
      </div>

      <div class="gift-guide__illustration">
        {%- if section.settings.illustration_image != blank -%}
          <img
            src="{{ section.settings.illustration_image | img_url: '1000x' }}"
            class="gift-guide__illustration-image"
            loading="lazy"
            alt="{{ section.settings.illustration_image.alt }}"
            width="{{ section.settings.illustration_image.width }}"
            height="{{ section.settings.illustration_image.height }}"
          >
        {%- else -%}
          <div class="gift-guide__illustration-placeholder">
            <p>Add your background illustration here.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="gift-guide__footer">
    <p>{{ section.settings.footer_text }}</p>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const illustration = document.querySelector(".gift-guide__illustration-image");
  const container = document.querySelector(".gift-guide__illustration");

  if (!illustration || !container) return;

  // Disable parallax on mobile
  if (window.innerWidth < 768) return;

  container.style.perspective = "1200px";

  container.addEventListener("mousemove", (e) => {
    const rect = container.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    const centerX = rect.width / 2;
    const centerY = rect.height / 2;

    const rotateX = ((y - centerY) / centerY) * 10; 
    const rotateY = ((centerX - x) / centerX) * 10; 

    illustration.style.transform = `
      rotateX(${rotateX}deg)
      rotateY(${rotateY}deg)
      translateZ(60px)
      scale(1.05)
    `;
  });

  container.addEventListener("mouseleave", () => {
    illustration.style.transform = `
      rotateX(0deg)
      rotateY(0deg)
      translateZ(0px)
      scale(1)
    `;
  });
});
</script>

{% schema %}
{
  "name": "Gift Guide Hero",
  "tag": "section",
  "class": "section-gift-guide",
  "settings": [
    { "type": "header", "content": "Header Settings" },
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "TISSO VISION" },
    { "type": "text", "id": "header_text", "label": "Header Announcement Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "header_button_text", "label": "Header Button Text", "default": "CHOOSE GIFT →" },
    { "type": "url", "id": "header_button_link", "label": "Header Button Link" },

    { "type": "header", "content": "Main Content Settings" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Gift Guide" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>" },
    { "type": "text", "id": "main_button_text", "label": "Main Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "main_button_link", "label": "Main Button Link" },

    { "type": "header", "content": "Background & Footer" },
    { "type": "image_picker", "id": "illustration_image", "label": "Background Illustration" },
    { "type": "text", "id": "footer_text", "label": "Footer Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [
    { "name": "Gift Guide Hero", "category": "Image" }
  ]
}
{% endschema %}

<style>
.gift-guide {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  color: #000;
  position: relative;
  overflow: hidden;
}

.gift-guide__wrapper {
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  padding: 0 2rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  justify-content: center;
}

.gift-guide__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 0;
}

.gift-guide__header-button {
  background-color: #FFD700;
  padding: 0.75rem 1.5rem;
  border-radius: 0.5rem;
  text-decoration: none;
  font-weight: bold;
}

.gift-guide__content-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rem;
  flex-grow: 1;
  margin-top: 2rem;
}

.gift-guide__text-content { flex: 1; max-width: 50%; }

.gift-guide__title {
  font-size: 4rem;
  font-weight: 800;
}

.gift-guide__illustration {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  perspective: 1200px;
  transform-style: preserve-3d;
}

.gift-guide__illustration-image {
  max-width: 100%;
  height: auto;
  transition: transform 0.25s ease-out;
  will-change: transform;
  transform-style: preserve-3d;
}

@media (max-width: 1024px) {
  .gift-guide__content-container { flex-direction: column; text-align: center; }
  .gift-guide__text-content { max-width: 100%; }
}
</style>
